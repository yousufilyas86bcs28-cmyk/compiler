%{	Starts the C declaration section.
#include "y.tab.h"	Includes the header generated by Yacc. It contains the NUMBER token.
#include <stdlib.h>	Provides the atoi() function.
%}	Ends the C declaration section.
%%	Separates declarations from Lex rules.
[0-9]+	Matches one or more digits, such as 10, 25, 100.
{ yylval = atoi(yytext); return NUMBER; }	Converts the matched number from string to integer and sends it to Yacc as NUMBER.
[ \t] ;	Ignores spaces and tabs.
\n { return '\n'; }	When Enter/newline is found, sends newline to Yacc.
. { return yytext[0]; }	Matches operators such as +, -, *, /, ( and ).

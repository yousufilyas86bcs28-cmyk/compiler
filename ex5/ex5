Code	Explanation
%{	Starts the C declaration section.
#include <stdio.h>	Provides printf().
#include <stdlib.h>	Provides standard C functions.
int yylex();	Declares the Lex function that supplies tokens to Yacc.
void yyerror(char *s);	Declares the error-handling function.
%}	Ends the C declaration section.
%token NUMBER	Declares NUMBER as a token received from Lex.
%%	Starts the Yacc grammar rules.
input:	Defines the starting input structure.
/* empty */	Allows empty input.
| input line	Allows multiple lines/expressions.
;	Ends the input rule.
line:	Defines what one input line looks like.
'\n'	Allows an empty line.
| expr '\n'	An expression followed by Enter is a complete line.
{ printf("Result = %d\n", $1); }	Prints the calculated result. $1 contains the expression's value.
expr:	Defines an arithmetic expression.
NUMBER	An expression can simply be a number.
| expr '+' expr	Defines addition.
{ $$ = $1 + $3; }	Adds the two expression values and stores the result in $$.
| expr '-' expr	Defines subtraction.
{ $$ = $1 - $3; }	Subtracts the second value from the first.
| expr '*' expr	Defines multiplication.
{ $$ = $1 * $3; }	Multiplies the two values.
| expr '/' expr	Defines division.
if ($3 == 0)	Checks whether division by zero is attempted.
yyerror("Division by zero");	Displays an error if denominator is zero.
else	Otherwise, perform division.
$$ = $1 / $3;	Divides the two values.
| '(' expr ')'	Allows expressions inside parentheses.
$$ = $2;	Takes the value of the expression inside the parentheses.
%%	Ends the grammar rules.
void yyerror(char *s)	Defines the error-handling function.
printf("Error: %s\n", s);	Prints the error message.
int main()	Starting point of the program.
printf("Enter expressions:\n");	Displays a message asking for input.
yyparse();	Starts the Yacc parser.
return 0;	Ends the program successfully.








